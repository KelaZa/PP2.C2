<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Gestion_alumnos.InicioPage"
    Title="Inicio"
    BackgroundColor="#F3F6FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="18"
            HorizontalOptions="Center"
            WidthRequest="760">

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label
                    Text="Resumen general"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#193B68"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="Seguimiento académico de los estudiantes"
                    FontSize="14"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border
                BackgroundColor="White"
                Stroke="#DEE6EF"
                StrokeThickness="1"
                Padding="22">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Comisión"
                        FontSize="14"
                        TextColor="#475569" />
                    <Border
                        BackgroundColor="#F8FAFC"
                        Stroke="#B8C7D9"
                        StrokeThickness="1"
                        Padding="4,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Picker
                            Title="Seleccione una comisión"
                            ItemsSource="{Binding Comisiones}"
                            SelectedItem="{Binding ComisionSeleccionada, Mode=TwoWay}"
                            TextColor="#1E293B"
                            TitleColor="#64748B" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding MostrarEstadoVacio}"
                BackgroundColor="#FFFFFF"
                Stroke="#DEE6EF"
                StrokeThickness="1"
                Padding="28">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label
                        Text="{Binding TextoEstadoVacio}"
                        FontSize="17"
                        TextColor="#475569"
                        HorizontalTextAlignment="Center" />
                    <Button
                        Text="Registrar primer alumno"
                        Command="{Binding RegistrarPrimerAlumnoCommand}"
                        BackgroundColor="#16865D"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="46"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout IsVisible="{Binding MostrarMetricas}" Spacing="14">
                <Label
                    Text="Métricas de la comisión seleccionada"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#193B68"
                    HorizontalTextAlignment="Center" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" BackgroundColor="White" Stroke="#DEE6EF" StrokeThickness="1" Padding="14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Bajo" FontAttributes="Bold" TextColor="#16865D" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding RiesgoBajoTexto}" FontSize="28" FontAttributes="Bold" TextColor="#193B68" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="White" Stroke="#DEE6EF" StrokeThickness="1" Padding="14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Medio" FontAttributes="Bold" TextColor="#B45309" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding RiesgoMedioTexto}" FontSize="28" FontAttributes="Bold" TextColor="#193B68" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="White" Stroke="#DEE6EF" StrokeThickness="1" Padding="14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Alto" FontAttributes="Bold" TextColor="#B91C1C" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding RiesgoAltoTexto}" FontSize="28" FontAttributes="Bold" TextColor="#193B68" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" BackgroundColor="White" Stroke="#DEE6EF" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Asistencia promedio" FontAttributes="Bold" TextColor="#475569" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding AsistenciaPromedioTexto}" FontSize="26" FontAttributes="Bold" TextColor="#193B68" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="White" Stroke="#DEE6EF" StrokeThickness="1" Padding="16">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Tasa de entrega de trabajos" FontAttributes="Bold" TextColor="#475569" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding TasaEntregaTexto}" FontSize="26" FontAttributes="Bold" TextColor="#193B68" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border BackgroundColor="White" Stroke="#DEE6EF" StrokeThickness="1" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Intervenciones de estudiantes en riesgo" FontSize="17" FontAttributes="Bold" TextColor="#193B68" HorizontalTextAlignment="Center" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="Contactados" TextColor="#475569" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding IntervencionesContactadosTexto}" FontSize="24" FontAttributes="Bold" TextColor="#16865D" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Pendientes" TextColor="#475569" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding IntervencionesPendientesTexto}" FontSize="24" FontAttributes="Bold" TextColor="#B45309" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
